{
  "scene": "res://scenes/test/gait_course.tscn",
  "seed": 1234,
  "timeout_frames": 7200,
  "steps": [
    {"wait_frames": 5},
    {"call": {"node": ".", "method": "use_build", "args": ["scout"]}},
    {"call": {"node": ".", "method": "spawn_at", "args": ["flat"]}},
    {"wait_frames": 30},
    {"call": {"node": "%Telemetry", "method": "reset"}},

    {"call": {"node": ".", "method": "hold_action", "args": ["move_forward", true]}},
    {"wait_frames": 180},
    {"assert_prop": {"node": "%Telemetry", "prop": "top_speed_mps", "op": ">=", "value": 4.4}},
    {"assert_prop": {"node": "%Telemetry", "prop": "top_speed_mps", "op": "<=", "value": 4.6}},
    {"assert_prop": {"node": "%Telemetry", "prop": "time_to_top_s", "op": ">=", "value": 0.2}},
    {"assert_prop": {"node": "%Telemetry", "prop": "time_to_top_s", "op": "<=", "value": 0.3}},
    {"assert_prop": {"node": "%Telemetry", "prop": "input_to_motion_ticks", "op": "<=", "value": 2}},
    {"assert_prop": {"node": "%Telemetry", "prop": "first_lift_ticks", "op": "<=", "value": 1}},
    {"call": {"node": "%Telemetry", "method": "report", "args": ["walk_flat start"]}},

    {"call": {"node": "%Telemetry", "method": "reset"}},
    {"wait_frames": 600},
    {"assert_prop": {"node": "%Telemetry", "prop": "max_drift_m", "op": "<=", "value": 0.001}},
    {"assert_prop": {"node": "%Telemetry", "prop": "airborne_violations", "op": "==", "value": 0}},
    {"assert_prop": {"node": "%Telemetry", "prop": "bob_amplitude_m", "op": ">=", "value": 0.03}},
    {"assert_prop": {"node": "%Telemetry", "prop": "bob_amplitude_m", "op": "<=", "value": 0.05}},
    {"assert_prop": {"node": "%Telemetry", "prop": "body_height_m", "op": ">=", "value": 0.57}},
    {"assert_prop": {"node": "%Telemetry", "prop": "body_height_m", "op": "<=", "value": 0.63}},
    {"assert_prop": {"node": "%Telemetry", "prop": "top_speed_mps", "op": ">=", "value": 4.4}},
    {"call": {"node": "%Telemetry", "method": "report", "args": ["walk_flat 10s"]}},

    {"call": {"node": ".", "method": "hold_action", "args": ["move_forward", false]}},
    {"wait_frames": 60},
    {"assert_prop": {"node": "%Telemetry", "prop": "stop_time_s", "op": ">=", "value": 0.15}},
    {"assert_prop": {"node": "%Telemetry", "prop": "stop_time_s", "op": "<=", "value": 0.25}},
    {"call": {"node": "%Telemetry", "method": "report", "args": ["walk_flat stop"]}},

    {"call": {"node": ".", "method": "spawn_at", "args": ["flat"]}},
    {"wait_frames": 30},
    {"call": {"node": "%Telemetry", "method": "reset"}},
    {"action_press": "turn_left", "frames": 60},
    {"assert_prop": {"node": "%Telemetry", "prop": "max_yaw_rate_dps", "op": ">=", "value": 118.0}},
    {"assert_prop": {"node": "%Telemetry", "prop": "max_yaw_rate_dps", "op": "<=", "value": 122.0}},
    {"assert_prop": {"node": "%Telemetry", "prop": "time_to_turn_rate_s", "op": ">=", "value": 0.07}},
    {"assert_prop": {"node": "%Telemetry", "prop": "time_to_turn_rate_s", "op": "<=", "value": 0.13}},
    {"call": {"node": "%Telemetry", "method": "report", "args": ["walk_flat turn"]}},

    {"call": {"node": ".", "method": "spawn_at", "args": ["flat"]}},
    {"wait_frames": 30},
    {"call": {"node": "%Telemetry", "method": "reset"}},
    {"call": {"node": ".", "method": "hold_action", "args": ["aim", true]}},
    {"action_press": "turn_left", "frames": 60},
    {"call": {"node": ".", "method": "hold_action", "args": ["aim", false]}},
    {"assert_prop": {"node": "%Telemetry", "prop": "max_yaw_rate_dps", "op": ">=", "value": 70.0}},
    {"assert_prop": {"node": "%Telemetry", "prop": "max_yaw_rate_dps", "op": "<=", "value": 74.0}},
    {"call": {"node": "%Telemetry", "method": "report", "args": ["walk_flat aim turn"]}},

    {"call": {"node": ".", "method": "spawn_at", "args": ["flat"]}},
    {"wait_frames": 30},
    {"call": {"node": "%Telemetry", "method": "reset"}},
    {"action_press": "strafe_right", "frames": 120},
    {"assert_prop": {"node": "%Telemetry", "prop": "top_speed_mps", "op": ">=", "value": 3.27}},
    {"assert_prop": {"node": "%Telemetry", "prop": "top_speed_mps", "op": "<=", "value": 3.48}},
    {"call": {"node": "%Telemetry", "method": "report", "args": ["walk_flat strafe"]}},

    {"call": {"node": ".", "method": "spawn_at", "args": ["flat"]}},
    {"wait_frames": 30},
    {"call": {"node": "%Telemetry", "method": "reset"}},
    {"call": {"node": ".", "method": "hold_action", "args": ["move_forward", true]}},
    {"call": {"node": ".", "method": "hold_action", "args": ["strafe_right", true]}},
    {"wait_frames": 150},
    {"call": {"node": ".", "method": "hold_action", "args": ["move_forward", false]}},
    {"call": {"node": ".", "method": "hold_action", "args": ["strafe_right", false]}},
    {"assert_prop": {"node": "%Telemetry", "prop": "top_speed_mps", "op": "<=", "value": 4.6}},
    {"assert_prop": {"node": "%Telemetry", "prop": "airborne_violations", "op": "==", "value": 0}},
    {"call": {"node": "%Telemetry", "method": "report", "args": ["walk_flat diagonal"]}},
    {"assert_no_errors": true}
  ]
}
