[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/main.gd" id="1_main"]
[ext_resource type="PackedScene" path="res://scenes/world/valley.tscn" id="2_valley"]
[ext_resource type="PackedScene" path="res://scenes/walker/walker.tscn" id="3_walker"]
[ext_resource type="PackedScene" path="res://scenes/camera/orbit_camera.tscn" id="4_orbit"]
[ext_resource type="PackedScene" path="res://scenes/weapons/weapon_rig.tscn" id="5_rig"]
[ext_resource type="Script" path="res://scripts/combat/player_hurtbox.gd" id="6_hurtbox"]
[ext_resource type="Script" path="res://scripts/economy/collector.gd" id="7_collector"]
[ext_resource type="Script" path="res://scripts/economy/salvage_field.gd" id="8_salvage"]
[ext_resource type="Script" path="res://scripts/enemies/drone_field.gd" id="9_drones"]
[ext_resource type="Script" path="res://scripts/economy/recall_hold.gd" id="10_recall"]
[ext_resource type="Script" path="res://ui/aim/aim_marks.gd" id="11_marks"]
